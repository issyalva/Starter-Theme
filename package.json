{
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run shopify:dev\" \"npm run build:watch\"",
    "shopify:dev": "shopify theme dev -e dev",
    "build": "npm run tokens:build && vite build",
    "build:watch": "vite build --watch",
    "tokens:build": "node scripts/build-tokens.js",
    "tokens:watch": "node scripts/build-tokens.js --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,liquid,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,liquid,css,md}\""
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.10.0",
    "@types/node": "^25.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "style-dictionary": "^5.1.1",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "tailwindcss": "^4.1.17"
  }
}
