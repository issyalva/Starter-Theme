{
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run shopify:dev\" \"npm run build:watch\"",
    "shopify:dev": "shopify theme dev -e dev",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,liquid,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,liquid,css,md}\""
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "terser": "^5.44.1",
    "vite": "^7.2.2"
  }
}
