<header>
  <h2 class='header__title'>
    {{ shop.name | link_to: routes.root_url }}
  </h2>

  <div class='header__menu'>
    <nav aria-label='{{ 'general.navigation' | t }}'>
      <ul>
        {% for link in section.settings.menu.links %}
          <li>
            <a
              href='{{ link.url }}'
              {% if link.active %}
                aria-current='page'
              {% endif %}
            >
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>

  <div class='header__icons'>
    {% if shop.customer_accounts_enabled %}
      {{
        'icon-account.svg'
        | inline_asset_content
        | link_to: routes.account_url
      }}
    {% endif %}

    <button
      aria-controls='cart-drawer'
      aria-label='{{ 'cart.general.title' | t }}'
    >
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      {{ 'icon-cart.svg' | inline_asset_content }}
    </button>
  </div>
</header>

<dialog
  is='ui-drawer'
  id='cart-drawer'
  side='right'
  focus-trap
  aria-labelledby='cart-drawer-label'
>
  <div class='p-4'>
    <div class='flex justify-between items-center mb-4'>
      <h2 id='cart-drawer-label' class='text-lg font-bold'>
        {{ 'cart.general.title' | t }}
      </h2>
      <button
        data-close-dialog
        aria-label='{{ 'general.accessibility.close' | t }}'
        class='text-2xl leading-none'
      >
        ✕
      </button>
    </div>

    {% if cart.item_count > 0 %}
      <div class='space-y-4 mb-4'>
        {% for item in cart.items %}
          <div class='flex gap-4'>
            <img
              src='{{ item.image | image_url: width: 80 }}'
              alt='{{ item.title }}'
              width='80'
              height='80'
              class='rounded'
            >
            <div class='flex-1'>
              <h3 class='font-semibold'>{{ item.product.title }}</h3>
              <p class='text-sm text-gray-600'>{{ item.variant.title }}</p>
              <p class='text-sm'>
                {{ item.quantity }} × {{ item.price | money }}
              </p>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class='border-t pt-4 space-y-2'>
        <div class='flex justify-between items-center mb-4'>
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <strong class='text-lg'>{{ cart.total_price | money }}</strong>
        </div>
        <a
          href='{{ routes.cart_url }}'
          class='block w-full text-center py-2 border rounded'
        >
          {{ 'cart.general.view_cart' | t }}
        </a>
        <a
          href='{{ routes.checkout_url }}'
          class='block w-full text-center py-2 bg-black text-white rounded'
        >
          {{ 'cart.general.checkout' | t }}
        </a>
      </div>
    {% else %}
      <p class='text-center text-gray-500 py-8'>
        {{ 'cart.general.empty' | t }}
      </p>
    {% endif %}
  </div>
</dialog>

{% stylesheet %}
  header {
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  header a {
    position: relative;
    text-decoration: none;
    color: var(--color-foreground);
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header svg {
    width: 2rem;
  }
  header .header__menu,
  header .header__icons {
    display: flex;
    gap: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
