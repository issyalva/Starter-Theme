{% comment %}
  Welcome to Shopify theme development!
{% endcomment %}

<div class='welcome full-width'>
  <div class='welcome-content'>
    <div>
      <h1>Hello, World!</h1>

      <p class='welcome-description'>
        The Skeleton theme is a minimal, carefully structured Shopify theme
        designed to help you quickly get started. Designed with modularity,
        maintainability, and Shopify's best practices in mind.
      </p>

      <p class='welcome-description'>
        Themes shape the online store experience for merchants and their
        customers. Build fast, flexible themes at scale using Liquid, Shopify's
        theme templating language, along with HTML, CSS, JavaScript, and JSON.
      </p>
    </div>
    <div class='icon'>
      <img src='{{ 'shoppy-x-ray.svg' | asset_url }}' width='300' height='300'>
    </div>
  </div>
</div>

<div class='highlights'>
  <div class='highlight'>
    <h3>Key Concepts</h3>
    <p class='highlight-description'>
      Shopify themes are a package of template files, building blocks, and
      supporting assets. Use these building blocks to create modular,
      customizable themes.
    </p>
    <button aria-controls='demo-drawer' class='mt-4 p-2 border rounded'>
      Toggle Drawer
    </button>
    <dialog is='ui-drawer' id='demo-drawer' focus-trap aria-label='Demo drawer'>
      <div class='p-4 border rounded-2xl grid gap-y-1'>
        <button
          data-close-dialog
          aria-label='{{ "general.accessibility.close" | t }}'
        >
          ✕
        </button>
        <p>Hello! This is the drawer that can be toggled from anywhere.</p>
        <button data-close-dialog>Another close trigger</button>
      </div>
    </dialog>
  </div>

  <div class='highlight'>
    <h3>Liquid</h3>
    <p class='highlight-description'>
      The Liquid templating language is the backbone of Shopify themes, and is
      used to load dynamic content on storefronts. Extend Liquid objects to
      store and present custom data using metafields.
    </p>
    <button aria-controls='yo-mama' class='mt-4 p-2 border rounded'>
      Toggle Drawer
    </button>
    <ui-disclosure id='yo-mama'>
      <div class='p-4 border rounded-2xl grid gap-y-1'>
        <a href='#' data-close>Close</a>
        <p>
          Hello!!!! This is the generic ui-disclosure element that can be
          toggled from anywhere.
        </p>
      </div>
    </ui-disclosure>
    <p>
      {{
        'View the Liquid reference'
        | link_to: 'https://shopify.dev/docs/api/liquid'
      }}
    </p>
  </div>

  <div class='highlight'>
    <h3>Best Practices</h3>
    <p class='highlight-description'>
      To optimize your theme development experience, Shopify has established a
      set of best practices that you can refer to when developing your theme and
      setting up your toolchains and processes.
    </p>
    <button aria-controls='demo-modal' class='mt-4 p-2 border rounded'>
      Open Modal
    </button>
    <p>
      {{
        'Follow best practices'
        | link_to: 'https://shopify.dev/docs/storefronts/themes/best-practices'
      }}
    </p>
  </div>

  <div class='highlight'>
    <h3>Accordions</h3>
    <p class='highlight-description'>
      Accordion components let you organize content into collapsible sections.
      Use standalone items or groups with single mode.
    </p>
    <ui-accordion-item>
      <button
        aria-controls='faq-shipping'
        class='flex w-full justify-between items-center'
      >
        <h3>How long does shipping take?</h3>
        <span slot='icon-closed'>+</span>
        <span slot='icon-open'>−</span>
      </button>
      <ui-disclosure id='faq-shipping'>
        <p>
          Standard shipping takes 5-7 business days. Express shipping is
          available for 2-3 business days.
        </p>
      </ui-disclosure>
    </ui-accordion-item>
    <ui-accordion-group>
      <ui-accordion-item>
        <button
          aria-controls='faq-returns'
          class='flex w-full justify-between items-center'
        >
          What is your return policy?
          <span slot='icon-closed'>+</span>
          <span slot='icon-open'>−</span>
        </button>
        <ui-disclosure id='faq-returns'>
          <p>
            We accept returns within 30 days of purchase. Items must be unused
            and in original packaging.
          </p>
        </ui-disclosure>
      </ui-accordion-item>

      <ui-accordion-item>
        <button
          aria-controls='faq-payment'
          class='flex w-full justify-between items-center'
        >
          What payment methods do you accept?
          <span slot='icon-closed'>+</span>
          <span slot='icon-open'>−</span>
        </button>
        <ui-disclosure id='faq-payment'>
          <p>
            We accept all major credit cards, PayPal, Apple Pay, and Google Pay.
          </p>
        </ui-disclosure>
      </ui-accordion-item>
    </ui-accordion-group>
  </div>

  <div class='highlight'>
    <h3>Accordion Group</h3>
    <p class='highlight-description'>
      Accordion components let you organize content into collapsible sections.
      Groups enforce single-item mode by default. Add 'multiple' to allow many
      open.
    </p>
    <ui-accordion-group>
      <ui-accordion-item>
        <button
          aria-controls='group-shipping'
          class='flex w-full justify-between items-center'
        >
          <h3>How long does shipping take?</h3>
          <span slot='icon-closed'>+</span>
          <span slot='icon-open'>−</span>
        </button>
        <ui-disclosure id='group-shipping'>
          <p>
            Standard shipping takes 5-7 business days. Express shipping is
            available for 2-3 business days.
          </p>
        </ui-disclosure>
      </ui-accordion-item>
      <ui-accordion-item>
        <button
          aria-controls='group-returns'
          class='flex w-full justify-between items-center'
        >
          What is your return policy?
          <span slot='icon-closed'>+</span>
          <span slot='icon-open'>−</span>
        </button>
        <ui-disclosure id='group-returns' open>
          <p>
            We accept returns within 30 days of purchase. Items must be unused
            and in original packaging.
          </p>
        </ui-disclosure>
      </ui-accordion-item>
      <ui-accordion-item>
        <button
          aria-controls='group-payment'
          class='flex w-full justify-between items-center'
        >
          What payment methods do you accept?
          <span slot='icon-closed'>+</span>
          <span slot='icon-open'>−</span>
        </button>
        <ui-disclosure id='group-payment'>
          <p>
            We accept all major credit cards, PayPal, Apple Pay, and Google Pay.
          </p>
        </ui-disclosure>
      </ui-accordion-item>
    </ui-accordion-group>
  </div>
</div>

<dialog
  is='ui-modal'
  id='demo-modal'
  focus-trap
  aria-labelledby='demo-modal-label'
>
  <div class='p-6'>
    <div class='modal-header'>
      <h2 id='demo-modal-label'>Modal Dialog Example</h2>
      <button
        data-close-dialog
        class='modal-close'
        aria-label='{{ "general.accessibility.close" | t }}'
      >
        ✕
      </button>
    </div>
    <div class='modal-body'>
      <p>This is a centered modal dialog! It demonstrates:</p>
      <ul>
        <li>Centered positioning</li>
        <li>Backdrop overlay</li>
        <li>Focus trap</li>
        <li>Keyboard support (Esc to close)</li>
        <li>ARIA accessibility</li>
      </ul>
      <p>
        Click the backdrop, press Escape, or click the close button to dismiss.
      </p>
    </div>
    <div class='modal-footer'>
      <button data-close-dialog class='button'>Close</button>
      <button class='button button--primary'>Take Action</button>
    </div>
  </div>
</dialog>

{% stylesheet %}
  .welcome {
    display: grid;
    grid-template-columns: var(--content-grid);
    background-color: #f6f6f7;
    padding: 72px 0;
  }

  .welcome-content {
    grid-column: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 0 24px;
  }

  .welcome-description {
    max-width: 80ch;
    line-height: 1.4;
    margin-top: 1.5rem;
  }

  .icon {
    width: 300px;
  }

  .highlights {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 50px;
  }

  @media (max-width: 1100px) {
    .highlights {
      grid-template-columns: 1fr;
    }
  }

  .highlight {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 24px;
    border-radius: 8px;
    background-color: #eef3ff;
    color: rgb(92, 95, 98);
    line-height: 1.4;
  }

  .highlight > * + * {
    margin-top: 1rem;
  }

  .highlight h3 {
    font-size: 1rem;
    color: rgb(32, 34, 35);
  }

  .highlight-description {
    flex: 1 1;
  }

  .highlight a {
    display: flex;
    width: fit-content;
    background-color: rgb(250, 251, 251);
    box-shadow:
      rgba(0, 0, 0, 0.2) 0px -3px 0px 0px inset,
      rgba(255, 255, 255, 0.9) 0px 2px 0px 0px inset;
    border: 1px solid rgb(140, 145, 150);
    border-radius: 4px;
    color: rgb(92, 95, 98);
    padding: 3px 10px 5px;
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hello World",
  "settings": [],
  "presets": [
    {
      "name": "Hello World Template",
      "category": "Demo"
    }
  ]
}
{% endschema %}
