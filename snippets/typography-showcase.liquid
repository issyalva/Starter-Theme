{% doc %}
  Renders a typography showcase with real heading, body, and supporting text examples.

  Useful for validating the active type system, including element selectors and
  class aliases like .h1 through .h6.

  @example
  {% render 'typography-showcase' %}
{% enddoc %}

<section class='typography-showcase container'>
  <header class='typography-showcase__header'>
    <p class='text-eyebrow'>Typography showcase</p>
    <p class='text-caption'>
      Live preview of the current typography scale and utility classes
    </p>
  </header>

  <div class='typography-showcase__content container--content'>
    <section class='typography-showcase__group'>
      <h2 class='h4'>Headings (element + class alias)</h2>
      <div class='typography-showcase__sample'>
        <div class='typography-showcase__compare'>
          <p class='typography-showcase__label'>h1</p>
          <h1>Heading one uses h1</h1>
          <p class='typography-showcase__label'>.h1</p>
          <p class='h1'>Heading one via .h1</p>
        </div>
      </div>
      <div class='typography-showcase__sample'>
        <div class='typography-showcase__compare'>
          <p class='typography-showcase__label'>h2</p>
          <h2>Heading two uses h2</h2>
          <p class='typography-showcase__label'>.h2</p>
          <p class='h2'>Heading two via .h2</p>
        </div>
      </div>
      <div class='typography-showcase__sample'>
        <div class='typography-showcase__compare'>
          <p class='typography-showcase__label'>h3</p>
          <h3>Heading three uses h3</h3>
          <p class='typography-showcase__label'>.h3</p>
          <p class='h3'>Heading three via .h3</p>
        </div>
      </div>
      <div class='typography-showcase__sample'>
        <div class='typography-showcase__compare'>
          <p class='typography-showcase__label'>h4</p>
          <h4>Heading four uses h4</h4>
          <p class='typography-showcase__label'>.h4</p>
          <p class='h4'>Heading four via .h4</p>
        </div>
      </div>
      <div class='typography-showcase__sample'>
        <div class='typography-showcase__compare'>
          <p class='typography-showcase__label'>h5</p>
          <h5>Heading five uses h5</h5>
          <p class='typography-showcase__label'>.h5</p>
          <p class='h5'>Heading five via .h5</p>
        </div>
      </div>
      <div class='typography-showcase__sample'>
        <div class='typography-showcase__compare'>
          <p class='typography-showcase__label'>h6</p>
          <h6>Heading six uses h6</h6>
          <p class='typography-showcase__label'>.h6</p>
          <p class='h6'>Heading six via .h6</p>
        </div>
      </div>
    </section>

    <section class='typography-showcase__group'>
      <h2 class='h4'>Body and supporting text</h2>
      <div class='typography-showcase__sample'>
        <p class='typography-showcase__label'>.text-body + a</p>
        <p class='text-body'>
          Base body text is tuned for default reading flow in standard content
          blocks and includes <a href='#'>inline link styles</a> for
          content-heavy sections.
        </p>
      </div>

      <div class='typography-showcase__sample'>
        <p class='typography-showcase__label'>.text-body-lg</p>
        <p class='text-body-lg'>
          Large body text can be used for lead paragraphs and key messaging
          sections.
        </p>
      </div>

      <div class='typography-showcase__sample'>
        <p class='typography-showcase__label'>.text-caption</p>
        <p class='text-caption'>
          Caption text supports metadata, labels, and secondary helper content.
        </p>
      </div>

      <div class='typography-showcase__sample'>
        <p class='typography-showcase__label'>.text-eyebrow</p>
        <p class='text-eyebrow'>
          Eyebrow text highlights short section context
        </p>
      </div>

      <div class='typography-showcase__sample'>
        <p class='typography-showcase__label'>blockquote + cite</p>
        <blockquote>
          Good typography makes content easier to scan and more pleasant to
          read.
          <cite>Type system principle</cite>
        </blockquote>
      </div>

      <h3 class='h5'>Meta and caption text</h3>
      <div class='typography-showcase__sample'>
        <p class='typography-showcase__label'>small</p>
        <p>
          <small>Small element text for lightweight supporting copy.</small>
        </p>
      </div>

      <div class='typography-showcase__sample'>
        <p class='typography-showcase__label'>.text-meta</p>
        <p class='text-meta'>
          Text meta class for timestamps and helper labels.
        </p>
      </div>

      <div class='typography-showcase__sample'>
        <p class='typography-showcase__label'>figure + figcaption</p>
        <figure class='typography-showcase__figure'>
          <div class='typography-showcase__figure-sample'>
            Example media area
          </div>
          <figcaption>
            Figcaption text uses muted metadata styling by default.
          </figcaption>
        </figure>
      </div>

      <h3 class='h5'>List rhythm</h3>
      <div class='typography-showcase__sample'>
        <p class='typography-showcase__label'>ul</p>
        <ul>
          <li>Unordered list items use shared typography spacing.</li>
          <li>Nested content should still feel readable and consistent.</li>
        </ul>
      </div>

      <div class='typography-showcase__sample'>
        <p class='typography-showcase__label'>ol</p>
        <ol>
          <li>Ordered lists follow the same rhythm rules.</li>
          <li>Line height and list indentation remain predictable.</li>
        </ol>
      </div>
    </section>

    <section class='typography-showcase__group'>
      <h2 class='h4'>Rich Text Editor</h2>
      <div class='typography-showcase__sample'>
        <p class='typography-showcase__label'>.rte</p>
        <div class='rte'>
          <p>
            This wrapper keeps rich text rhythm predictable across content
            sections.
          </p>

          <h1>Heading one</h1>
          <p>
            The largest heading still feels editorial inside rich text content.
          </p>

          <h2>Heading two</h2>
          <p>
            Subheads keep the content hierarchy readable without matching the
            global page scale.
          </p>

          <h3>Heading three</h3>
          <p>
            This is useful for article sections and editor-authored content.
          </p>

          <h4>Heading four</h4>
          <p>
            Smaller headings keep longform content organized without adding
            visual weight.
          </p>

          <h5>Heading five</h5>
          <p>Lower emphasis headings remain legible and compact.</p>

          <h6>Heading six</h6>
          <p>
            Even the smallest heading level has enough separation from body
            copy.
          </p>

          <p>
            It also keeps inline <a href='#'>links</a> feeling editorial instead
            of matching the global page chrome exactly.
          </p>

          <p>
            Use it when you want headings, lists, and quotes to feel consistent
            without custom template CSS.
          </p>

          <ul>
            <li>Headings and body copy stay in the same rhythm.</li>
            <li>Lists and blockquotes inherit the same reading flow.</li>
          </ul>

          <ol>
            <li>Ordered lists keep their own spacing rhythm.</li>
            <li>Content stays compact without feeling cramped.</li>
          </ol>

          <blockquote>
            Good defaults are usually better than per-template one-offs.
            <cite>Styleguide note</cite>
          </blockquote>
        </div>
      </div>
    </section>
  </div>
</section>

{% stylesheet %}
  .typography-showcase__header {
    margin-bottom: var(--space-5);
  }

  .typography-showcase__content {
    background: var(--color-surface, var(--light));
  }

  .typography-showcase__group + .typography-showcase__group {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--color-border, var(--gray-300));
  }

  .typography-showcase__group > * + * {
    margin-top: var(--space-2);
  }

  .typography-showcase__sample {
    padding: var(--space-3);
    background: var(--color-surface-muted, var(--gray-100));
    border: var(--border-width) solid var(--color-border, var(--gray-300));
  }

  .typography-showcase__sample + .typography-showcase__sample {
    margin-top: var(--space-3);
  }

  .typography-showcase__label {
    margin: 0 0 var(--space-2);
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
    font-size: var(--font-size-caption);
    line-height: 1.3;
    color: var(--color-text-muted, var(--gray-500));
  }

  .typography-showcase__compare > * + * {
    margin-top: var(--space-2);
  }

  .typography-showcase__figure {
    margin: 0;
  }

  .typography-showcase__figure-sample {
    display: grid;
    place-items: center;
    min-height: var(--space-8);
    border: var(--border-width) dashed
      var(--color-border-strong, var(--gray-500));
    background: var(--color-surface-muted, var(--gray-100));
  }
{% endstylesheet %}
