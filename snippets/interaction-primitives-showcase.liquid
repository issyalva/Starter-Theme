{% doc %}
  Renders a showcase for surface and details/summary primitives.

  Keeps container and native disclosure examples outside typography-focused
  sections to separate concerns in the styleguide.

  @example
  {% render 'interaction-primitives-showcase' %}
{% enddoc %}

<section class='interaction-showcase container'>
  <header class='interaction-showcase__header'>
    <p class='text-eyebrow'>Interaction primitives showcase</p>
    <p class='text-caption'>Live preview of surface and details primitives</p>
  </header>

  <div class='interaction-showcase__content container--content'>
    <section class='interaction-showcase__group'>
      <h2 class='h4'>Surface</h2>
      <div class='interaction-showcase__sample'>
        <p class='interaction-showcase__label'>.surface</p>
        <div class='surface'>
          <p class='text-eyebrow'>Card treatment</p>
          <p class='text-body'>
            Use this for cards, callouts, and other neutral containers that need
            a clear boundary.
          </p>
          <a href='#'>Learn more</a>
        </div>
      </div>
    </section>

    <section class='interaction-showcase__group'>
      <h2 class='h4'>Details and summary</h2>
      <div class='interaction-showcase__sample'>
        <p class='interaction-showcase__label'>details > summary</p>
        <details open>
          <summary>Read more</summary>
          <p class='text-body'>
            Native details is a good low-JavaScript disclosure fallback for
            simple content.
          </p>
        </details>
      </div>
    </section>
  </div>
</section>

{% stylesheet %}
  .interaction-showcase__header {
    margin-bottom: var(--space-5, 1.5rem);
  }

  .interaction-showcase__content {
    background: var(--color-surface, var(--light, #fff));
  }

  .interaction-showcase__group + .interaction-showcase__group {
    margin-top: var(--space-6, 2rem);
    padding-top: var(--space-6, 2rem);
    border-top: var(--border-width, 1px) solid
      var(--color-border, var(--gray-300, #d1d5db));
  }

  .interaction-showcase__group > * + * {
    margin-top: var(--space-2, 0.5rem);
  }

  .interaction-showcase__sample {
    padding: var(--space-3, 0.75rem);
    border-radius: var(--radius-sm, 0.5rem);
    background: var(--color-surface-muted, var(--gray-100, #f3f4f6));
    border: var(--border-width, 1px) solid
      var(--color-border, var(--gray-300, #d1d5db));
  }

  .interaction-showcase__label {
    margin: 0 0 var(--space-2, 0.5rem);
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
    font-size: var(--font-size-caption, 0.75rem);
    line-height: 1.3;
    color: var(--color-text-muted, var(--gray-500, #6b7280));
  }
{% endstylesheet %}
