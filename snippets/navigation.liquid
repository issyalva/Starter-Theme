{% doc %}
  Renders the main navigation with support for dropdown and mega menu items.

  @param {object} links - Navigation links (from section.settings.menu.links)

  @example
  {% render 'navigation', links: section.settings.menu.links %}
{% enddoc %}

<nav aria-label='{{ 'general.navigation' | t }}'>
  <ul>
    {% for link in links %}
      <li>
        {%- assign has_grandchildren = false -%}
        {%- for child in link.links -%}
          {%- if child.links and child.links.size > 0 -%}
            {%- assign has_grandchildren = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_grandchildren -%}
          <!-- Mega menu trigger -->
          <div class='mega-menu'>
            <button
              type='button'
              aria-haspopup='true'
              aria-controls='mega-menu-{{ forloop.index }}'
              class='dropdown-trigger'
              id='mega-trigger-{{ forloop.index }}'
            >
              {{ link.title }}
            </button>
            <mega-menu
              id='mega-menu-{{ forloop.index }}'
              aria-labelledby='mega-trigger-{{ forloop.index }}'
            >
              <div class='mega-menu-grid'>
                {% for child in link.links %}
                  {% if child.links and child.links.size > 0 %}
                    <div>
                      <span class='mega-menu-column-title'>
                        {{- child.title -}}
                      </span>
                      <ul class='mega-menu-list'>
                        {% for grandchild in child.links %}
                          <li>
                            <a href='{{ grandchild.url }}'>
                              {{- grandchild.title -}}
                            </a>
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </mega-menu>
          </div>
        {%- elsif link.links and link.links.size > 0 -%}
          <!-- Dropdown menu item using disclosure -->
          <div class='dropdown'>
            <button
              type='button'
              aria-haspopup='true'
              aria-controls='dropdown-{{ forloop.index }}'
              class='dropdown-trigger'
            >
              {{ link.title }}
            </button>
            <dropdown-menu id='dropdown-{{ forloop.index }}'>
              <ul
                class='dropdown-menu-list'
                role='menu'
                tabindex='-1'
              >
                {% for sublink in link.links %}
                  <li role='none'>
                    <a href='{{ sublink.url }}' role='menuitem'>
                      {{- sublink.title -}}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </dropdown-menu>
          </div>
        {%- else -%}
          <!-- Simple nav item -->
          <a
            href='{{ link.url }}'
            {% if link.active %}
              aria-current='page'
            {% endif %}
          >
            {{ link.title }}
          </a>
        {%- endif -%}
      </li>
    {% endfor %}
  </ul>
</nav>
